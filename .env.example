# ============================================
# DESA KALEMAGO BACKEND - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

PORT=3000

# IMPORTANT: Change this to a strong random string in production!
# Generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production

# GitHub Integration (optional but used for data persistence)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
# ============================================
# PENTING: GitHub Data Sync Configuration
# ============================================
# Backend ini menyimpan data (users.xlsx, products, team, dll)
# ke dalam REPO FRONTEND, bukan repo backend.
#
# GITHUB_REPO harus = nama repo FRONTEND
GITHUB_OWNER=biskuitz
GITHUB_REPO=desakalemago2          # ← Repo FRONTEND (desakalemago2), BUKAN desakalemago2-backend

# Allowed CORS origins (comma separated if needed)
# CORS_ORIGIN=https://biskuitz.github.io,https://biskuitz.github.io/desakalemago2